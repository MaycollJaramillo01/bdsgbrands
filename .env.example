# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Canonical origin and environment. Only "production" makes the site indexable.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_ENV=
# Public contact address (hidden on the site while empty)
NEXT_PUBLIC_CONTACT_EMAIL=
# Analytics: load only after visitor consent, and only when set
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only
META_CAPI_TOKEN=
SAFETY_CONTACT_EMAIL=
# Feature switches (true/false). Defaults: catalog on, everything else off.
NEXT_PUBLIC_CATALOG_LIVE=
NEXT_PUBLIC_CHECKOUT_LIVE=
NEXT_PUBLIC_MEMBERSHIP_ENROLLMENT_LIVE=
# Staging only: show draft legal text. A production build refuses to start with this on.
NEXT_PUBLIC_SHOW_DRAFT_POLICIES=
# Server-only: commerce adapter (none | mock in dev). Real provider is blocked by BDSG.
COMMERCE_PROVIDER=
COMMERCE_CHECKOUT_ORIGIN=

# Admin "Publicar cambios" button (server-only). Vercel → Settings → Git → Deploy Hooks, branch main.
VERCEL_DEPLOY_HOOK_URL=
